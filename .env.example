# Chave da API do OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sua_chave_aqui

# Modelo a usar via OpenRouter (padrão: openai/gpt-4o-mini)
# Dica: priorize modelos com tool calling nativo (gpt-4o-mini, tencent/hy3).
# Modelos pequenos como llama-3.1-8b NÃO executam tools corretamente.
OPENROUTER_MODEL=openai/gpt-4o-mini
